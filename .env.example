# Copy to .env on your server. Never commit the actual .env.
# Select an available model supporting Responses web_search and structured output.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: enables direct X discovery and recent-post retrieval.
X_BEARER_TOKEN=
# Create your bot with Telegram's @BotFather; /start it from your own account.
TELEGRAM_BOT_TOKEN=
# Your numeric PRIVATE chat ID, verified using --check-telegram.
TELEGRAM_CHAT_ID=
